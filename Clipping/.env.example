# .env.example - variables necesarias para desarrollo y Docker Compose
# Copia este archivo a .env y rellena tus claves

# APIs
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# AWS (opcional si usas S3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=clips-virales-prod
AWS_REGION=us-east-1

# Debug / entorno
DEBUG=True
ENVIRONMENT=development

# URLs internas (opcional - docker-compose usa valores por defecto)
# DATABASE_URL=postgresql://clips_user:clips_password_secure@db:5432/clips_virales_db
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1

# Otros
# PORT para la API (si quieres sobrescribir)
PORT=8000
