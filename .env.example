# ============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ============================================================================

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/clips_virales_db
SQLALCHEMY_ECHO=False

# Redis (Celery Broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Google Generative AI
GOOGLE_API_KEY=tu_google_api_key_aqui

# OpenAI (GPT-4o)
OPENAI_API_KEY=tu_openai_api_key_aqui

# ElevenLabs (TTS Premium)
ELEVENLABS_API_KEY=tu_elevenlabs_api_key_aqui

# Pexels API (B-Roll)
PEXELS_API_KEY=tu_pexels_api_key_aqui

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=tu_aws_access_key
AWS_SECRET_ACCESS_KEY=tu_aws_secret_key
AWS_S3_BUCKET=clips-virales-prod
AWS_REGION=us-east-1

# Google Cloud Storage (Alternativa a S3)
GCS_PROJECT_ID=tu_gcs_project_id
GCS_BUCKET=clips-virales-gcs

# OAuth2 Configuration
SECRET_KEY=tu_secret_key_super_seguro_aqui_min_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 - YouTube
YOUTUBE_CLIENT_ID=tu_youtube_client_id
YOUTUBE_CLIENT_SECRET=tu_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# OAuth2 - Instagram
INSTAGRAM_CLIENT_ID=tu_instagram_client_id
INSTAGRAM_CLIENT_SECRET=tu_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/auth/instagram/callback

# OAuth2 - TikTok
TIKTOK_CLIENT_ID=tu_tiktok_client_id
TIKTOK_CLIENT_SECRET=tu_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:8000/auth/tiktok/callback

# Application Configuration
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Processing Configuration
MAX_VIDEO_DURATION_SECONDS=300
MAX_CONCURRENT_RENDERS=3
TEMP_FILES_DIR=/tmp/clips_virales

# Platform Limits
YOUTUBE_MAX_FILE_SIZE_MB=5000
INSTAGRAM_MAX_FILE_SIZE_MB=4000
TIKTOK_MAX_FILE_SIZE_MB=287

# Email Configuration (para notificaciones)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM_EMAIL=noreply@clipvirales.com
